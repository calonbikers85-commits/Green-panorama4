# Firebase Configuration for Green Panorama 4
# Copy this file to .env and fill with your Firebase Web App credentials from Firebase Console
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Admin Initial Setup secret token (optional security feature)
VITE_APP_NAME="Green Panorama 4"
